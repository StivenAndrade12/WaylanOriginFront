@page "/admin/organizacion/{Id:int}"

@using Microsoft.AspNetCore.Components.Forms
@using WaylanOrigin.Client.Services
@using WaylanOrigin.Client.Models

@inject ApiService Api

<h2 class="admin-title">Editar Organización: @org?.Nombre</h2>

@if (isLoading)
{
    <p>Cargando datos de la organización...</p>
}
else if (org == null)
{
    <p>No se encontró la organización especificada.</p>
}
else
{
    <EditForm Model="org" OnSubmit="GuardarCambios">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="admin-form-grid">

            <!-- SECCIÓN GENERAL Y HERO -->
            <h3>Información Principal y Hero</h3>

            <div class="admin-field">
                <label>Nombre de la Organización</label>
                <InputText @bind-Value="org.Nombre" class="admin-input" />
            </div>

            <div class="admin-field">
                <label>Imagen Logo (URL)</label>
                <InputText @bind-Value="org.ImagenLogo" class="admin-input" placeholder="ej: logotipo/5.png" />
                <InputFile OnChange="SubirLogo" accept="image/*" class="admin-input" style="margin-top: 5px;" />

                @if (!string.IsNullOrEmpty(org.ImagenLogo))
                {
                    <div style="margin-top: 8px;">
                        <img src="@org.ImagenLogo" alt="Vista previa Logo"
                             style="max-height: 80px; border-radius: 4px; border: 1px solid #ccc; padding: 4px; background: #fff;" />
                    </div>
                }
            </div>

            <div class="admin-field">
                <label>Imagen del Hero (URL)</label>
                <InputText @bind-Value="org.HeroImagen" class="admin-input" placeholder="ej: imagenes/camp.png" />
                <InputFile OnChange="SubirHeroImagen" accept="image/*" class="admin-input" style="margin-top: 5px;" />

                @if (!string.IsNullOrEmpty(org.HeroImagen))
                {
                    <div style="margin-top: 8px;">
                        <img src="@org.HeroImagen" alt="Vista previa Hero"
                             style="max-height: 120px; border-radius: 6px; border: 1px solid #ccc;" />
                    </div>
                }
            </div>

            <div class="admin-field">
                <label>Descripción 1</label>
                <InputTextArea @bind-Value="org.Descripcion1" class="admin-textarea" rows="3" />
            </div>

            <div class="admin-field">
                <label>Descripción 2</label>
                <InputTextArea @bind-Value="org.Descripcion2" class="admin-textarea" rows="3" />
            </div>

            <!-- ENFOQUE -->
            <h3>Enfoque</h3>

            <div class="admin-field">
                <label>Enfoque / Compromiso</label>
                <InputText @bind-Value="org.Enfoque" class="admin-input" />
            </div>

        </div>

        <button type="submit" class="admin-btn-save" style="margin-top: 20px;">Guardar cambios</button>

        @if (!string.IsNullOrEmpty(mensaje))
        {
            <p class="admin-message" style="margin-top: 10px; font-weight: bold;">@mensaje</p>
        }
    </EditForm>
}

@code {
    [Parameter] public int Id { get; set; }

    private OrganizationModel? org;
    private List<ProductorModel> productoresOrganizacion = new();
    private bool isLoading = true;
    private string mensaje = string.Empty;

    private IBrowserFile? logoFile;
    private IBrowserFile? heroFile;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        var organizaciones = await Api.GetOrganizacionesAsync();

        if (organizaciones != null && organizaciones.Any())
        {
            org = organizaciones.FirstOrDefault(o => o.Id == Id)
                  ?? organizaciones.FirstOrDefault();
        }

        var todosProductores = await Api.GetProductoresAsync();
        if (todosProductores != null && org != null)
        {
            productoresOrganizacion = todosProductores
                .Where(p => p.IdOrganizacion == org.Id)
                .ToList();
        }

        isLoading = false;
    }

    private void SubirLogo(InputFileChangeEventArgs e)
    {
        if (e.File != null) logoFile = e.File;
    }

    private void SubirHeroImagen(InputFileChangeEventArgs e)
    {
        if (e.File != null) heroFile = e.File;
    }

    private async Task GuardarCambios()
    {
        if (org == null) return;

        mensaje = "Guardando...";

        var ok = await Api.UpdateOrganizacionAsync(org);
        if (ok)
        {
            mensaje = "¡Cambios guardados correctamente!";
            StateHasChanged();
        }
        else
        {
            mensaje = "Error al intentar guardar los cambios.";
        }
    }
}