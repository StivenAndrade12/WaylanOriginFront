@page "/admin/productores"


@using WaylanOrigin.Client.Services
@using WaylanOrigin.Client.Models
@using Microsoft.AspNetCore.Components.Forms

@inject ApiService ApiService

<div class="panel-section">

    <div class="panel-header-row">
        <h2>Gestión de Productores</h2>
        <button type="button" class="btn-create-new" @onclick="NuevoProductor">NUEVO PRODUCTOR</button>
    </div>

    @if (productores == null)
    {
        <p>Cargando...</p>
    }
    else
    {
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Destacado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in productores)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td>@p.Nombre</td>
                        <td>@(p.Destacado ? "Sí" : "No")</td>
                        <td>
                            <button type="button" class="btn-action-edit" @onclick="() => EditarProductor(p)">Editar</button>
                            <button type="button" class="btn-action-delete"
                                    @onclick="() => EliminarProductor(p.Id)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (editando)
    {
        <div class="panel-section" style="margin-top: 30px;">

            <h2 class="section-title">@(productorEdit.Id == 0 ? "Nuevo Productor" : "Editar Productor")</h2>

            <EditForm Model="productorEdit" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />

                <!-- INFORMACIÓN GENERAL -->
                <h3 class="section-title">Información General</h3>

                <div class="form-group mb-3">
                    <label>Nombre del Productor</label>
                    <InputText class="form-control-admin" @bind-Value="productorEdit.Nombre"
                               placeholder="Nombre completo" />
                </div>

                <div class="form-group mb-3">
                    <label>Frase Representativa</label>
                    <InputText class="form-control-admin" @bind-Value="productorEdit.Frase"
                               placeholder="Frase célebre o cita" />
                </div>

                <div class="form-group mb-3">
                    <label class="section-label">Organización</label>
                    <select class="form-control-admin" @bind="productorEdit.IdOrganizacion">
                        <option value="0">-- Seleccionar Organización --</option>
                        @foreach (var org in organizaciones)
                        {
                            <option value="@org.Id">@org.Nombre</option>
                        }
                    </select>
                </div>

                <div class="form-group mb-3">
                    <label>
                        <InputCheckbox @bind-Value="productorEdit.Destacado" /> Marcar como Productor Destacado
                    </label>
                </div>

                <!-- HISTORIA Y SOSTENIBILIDAD -->
                <h3 class="section-title">Historia y Sostenibilidad</h3>

                <div class="form-group mb-3">
                    <label>Título de la Historia</label>
                    <InputText class="form-control-admin" @bind-Value="productorEdit.HistoriaTitulo"
                               placeholder="Título para la sección de historia" />
                </div>

                <div class="form-group mb-3">
                    <label>Texto de la Historia</label>
                    <InputTextArea class="form-control-admin" @bind-Value="productorEdit.HistoriaTexto" rows="4"
                                   placeholder="Relato detallado..." />
                </div>

                <div class="form-group mb-3">
                    <label>Descripción de Sostenibilidad</label>
                    <InputTextArea class="form-control-admin" @bind-Value="productorEdit.SostenibilidadDescripcion" rows="3"
                                   placeholder="Prácticas sostenibles..." />
                </div>

                <!-- IMAGEN PRINCIPAL -->
                <h3 class="section-title">Imagen Principal</h3>

                <div class="form-group mb-3">
                    <InputText class="form-control-admin" @bind-Value="productorEdit.ImagenPrincipal"
                               placeholder="URL de la imagen principal" />
                    <InputFile OnChange="SubirImagenPrincipal" accept="image/*" class="form-control-admin mt-2" />

                    @if (!string.IsNullOrEmpty(productorEdit.ImagenPrincipal))
                    {
                        <div style="margin-top: 8px;">
                            <img src="@productorEdit.ImagenPrincipal" alt="Vista previa principal"
                                 style="max-height: 120px; border-radius: 4px; border: 1px solid #ccc;" />
                        </div>
                    }
                </div>

                <!-- PROCEDIMIENTOS -->
                <h3 class="section-title">Procedimientos</h3>

                @for (int i = 0; i < productorEdit.Procedimientos.Count; i++)
                {
                    var index = i;
                    var proc = productorEdit.Procedimientos[index];
                    <div class="proceso-box"
                         style="margin-bottom: 15px; border: 1px solid #ddd; padding: 15px; border-radius: 6px; background-color: #f9f9f9;">

                        <div class="form-group mb-2">
                            <label>Nombre del Procedimiento</label>
                            <InputText class="form-control-admin" @bind-Value="proc.Nombre" placeholder="Ej: Recolección" />
                        </div>

                        <div class="form-group mb-2">
                            <label>Título</label>
                            <InputText class="form-control-admin" @bind-Value="proc.Titulo"
                                       placeholder="Ej: Selección manual de grano" />
                        </div>

                        <div class="form-group mb-2">
                            <label>Descripción</label>
                            <InputTextArea class="form-control-admin" @bind-Value="proc.Descripcion" rows="2" />
                        </div>

                        <div class="form-group mb-2">
                            <label>Imagen (URL)</label>
                            <InputText class="form-control-admin" @bind-Value="proc.Imagen" placeholder="URL de la imagen" />
                            <InputFile OnChange="@(e => SubirImagenProcedimiento(e, index))" accept="image/*"
                                       class="form-control-admin mt-1" />

                            @if (!string.IsNullOrEmpty(proc.Imagen))
                            {
                                <img src="@proc.Imagen" alt="Vista previa procedimiento"
                                     style="max-height: 80px; margin-top: 5px; display: block; border-radius: 4px;" />
                            }
                        </div>

                        <button type="button" class="btn-action-delete" style="margin-top: 10px;"
                                @onclick="() => EliminarProcedimiento(proc)">Eliminar Procedimiento</button>
                    </div>
                }

                <button type="button" class="btn-add-proceso mb-3" @onclick="AgregarProcedimiento">Agregar
                    Procedimiento</button>

                    <!-- BOTONES -->
                    <div style="margin-top: 25px;">
                        <button class="btn-save" type="submit">Guardar</button>
                        <button type="button" class="btn-cancel" @onclick="Cancelar">Cancelar</button>
                    </div>

                </EditForm>
            </div>
        }
    </div>

@code {
    private List<ProductorModel> productores = new();
    private List<OrganizationModel> organizaciones = new();
    private ProductorModel productorEdit = new();
    private bool editando = false;

    protected override async Task OnInitializedAsync()
    {
        productores = await ApiService.GetProductoresAsync() ?? new List<ProductorModel>();
        organizaciones = await ApiService.GetOrganizacionesAsync() ?? new List<OrganizationModel>();
    }

    private void NuevoProductor()
    {
        productorEdit = new ProductorModel
        {
            Procedimientos = new List<ProcedimientoModel>()
        };

        editando = true;
    }

    private void EditarProductor(ProductorModel p)
    {
        productorEdit = new ProductorModel
        {
            Id = p.Id,
            IdOrganizacion = p.IdOrganizacion,
            Destacado = p.Destacado,
            Nombre = p.Nombre,
            Frase = p.Frase,
            HistoriaTitulo = p.HistoriaTitulo,
            HistoriaTexto = p.HistoriaTexto,
            SostenibilidadDescripcion = p.SostenibilidadDescripcion,
            ImagenPrincipal = p.ImagenPrincipal,
            Procedimientos = p.Procedimientos?.Select(x => new ProcedimientoModel
            {
                Id = x.Id,
                Nombre = x.Nombre,
                Titulo = x.Titulo,
                Descripcion = x.Descripcion,
                Imagen = x.Imagen,
                IdProductor = x.IdProductor
            }).ToList() ?? new List<ProcedimientoModel>()
        };

        editando = true;
    }

    private async Task SubirImagenPrincipal(InputFileChangeEventArgs e)
    {
        if (e.File != null)
        {
            var url = await ApiService.UploadImageAsync(e.File);
            if (!string.IsNullOrEmpty(url))
            {
                productorEdit.ImagenPrincipal = url;
                StateHasChanged();
            }
        }
    }

    private async Task SubirImagenProcedimiento(InputFileChangeEventArgs e, int index)
    {
        if (e.File != null && index < productorEdit.Procedimientos.Count)
        {
            var url = await ApiService.UploadImageAsync(e.File);
            if (!string.IsNullOrEmpty(url))
            {
                productorEdit.Procedimientos[index].Imagen = url;
                StateHasChanged();
            }
        }
    }

    private void AgregarProcedimiento()
    {
        productorEdit.Procedimientos.Add(new ProcedimientoModel());
    }

    private void EliminarProcedimiento(ProcedimientoModel proc)
    {
        productorEdit.Procedimientos.Remove(proc);
    }

    private async Task Guardar()
    {
        if (productorEdit.Id == 0)
        {
            await ApiService.CrearProductorAsync(productorEdit);
        }
        else
        {
            await ApiService.ActualizarProductorAsync(productorEdit);
        }

        editando = false;
        productores = await ApiService.GetProductoresAsync() ?? new List<ProductorModel>();
    }

    // ✅ CORRECTO (Pasa el id como entero directo)
    private async Task EliminarProductor(int id)
    {
        await ApiService.EliminarProductorAsync(id);
        productores = await ApiService.GetProductoresAsync() ?? new List<ProductorModel>();
    }

    private void Cancelar()
    {
        editando = false;
    }
}