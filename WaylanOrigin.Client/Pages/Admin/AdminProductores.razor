@page "/admin/productores"

@using WaylanOrigin.Client.Services
@using WaylanOrigin.Client.Models
@using Microsoft.AspNetCore.Components.Forms

@inject ApiService ApiService

<div class="panel-section">

    <div class="panel-header-row">
        <h2>Gestión de Productores</h2>
        <button type="button" class="btn-create-new" @onclick="NuevoProductor">NUEVO PRODUCTOR</button>
    </div>

    @if (!string.IsNullOrEmpty(mensajeAlerta))
    {
        <div class="admin-message-banner" style="margin: 15px 0; padding: 12px; border-radius: 6px; background-color: @(esErrorAlerta ? "#ffebee" : "#e8f5e9"); color: @(esErrorAlerta ? "#c62828" : "#2e7d32"); border: 1px solid @(esErrorAlerta ? "#ffcdd2" : "#c8e6c9");">
            <strong>@mensajeAlerta</strong>
        </div>
    }

    @if (isLoading)
    {
        <p>Cargando productores...</p>
    }
    else if (productores == null || !productores.Any())
    {
        <div class="alert alert-info">No hay productores registrados. Puedes crear uno con el botón superior.</div>
    }
    else
    {
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Imagen</th>
                    <th>Nombre</th>
                    <th>Organización</th>
                    <th>Ubicación</th>
                    <th>Destacado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in productores)
                {
                    <tr>
                        <td><strong>#@p.Id</strong></td>
                        <td>
                            <img src="@ApiService.GetFullImageUrl(p.ImagenPrincipal)" alt="@p.Nombre"
                                 style="width: 44px; height: 44px; border-radius: 50%; object-fit: cover; border: 1px solid #ccc;" />
                        </td>
                        <td><strong>@p.Nombre</strong></td>
                        <td>
                            <span class="badge-org" style="background: #eef2ff; color: #3730a3; padding: 4px 8px; border-radius: 4px; font-weight: 500;">
                                @(ObtenerNombreOrganizacion(p.IdOrganizacion, p.OrganizacionNombre))
                            </span>
                        </td>
                        <td>@(string.IsNullOrEmpty(p.Ubicacion) ? "—" : p.Ubicacion)</td>
                        <td>@(p.Destacado ? "★ Sí" : "No")</td>
                        <td>
                            <button type="button" class="btn-action-edit" @onclick="() => EditarProductor(p)">Editar</button>
                            <button type="button" class="btn-action-delete"
                                    @onclick="() => EliminarProductor(p.Id)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (editando)
    {
        <div class="panel-section" style="margin-top: 30px; border-top: 2px solid #eee; padding-top: 25px;">

            <h2 class="section-title">@(productorEdit.Id == 0 ? "Nuevo Productor" : $"Editar Productor #{productorEdit.Id}: {productorEdit.Nombre}")</h2>

            <EditForm Model="productorEdit">
                <DataAnnotationsValidator />

                <!-- INFORMACIÓN GENERAL -->
                <h3 class="section-title">Información General y Organización</h3>

                <div class="form-group mb-3">
                    <label>Nombre del Productor *</label>
                    <InputText class="form-control-admin" @bind-Value="productorEdit.Nombre"
                               placeholder="Nombre completo" />
                </div>

                <div class="form-group mb-3">
                    <label class="section-label">Organización Perteneciente *</label>
                    <select class="form-control-admin" @bind="productorEdit.IdOrganizacion">
                        <option value="0">-- Seleccionar Organización --</option>
                        @foreach (var org in organizaciones)
                        {
                            <option value="@org.Id">@org.Nombre (ID: @org.Id)</option>
                        }
                    </select>
                </div>

                <div class="form-group mb-3">
                    <label>Ubicación / Región</label>
                    <InputText class="form-control-admin" @bind-Value="productorEdit.Ubicacion"
                               placeholder="Ej: Planadas, Tolima — Colombia" />
                </div>

                <div class="form-group mb-3">
                    <label>Frase Representativa</label>
                    <InputText class="form-control-admin" @bind-Value="productorEdit.Frase"
                               placeholder="Frase célebre o cita" />
                </div>

                <div class="form-group mb-3">
                    <label style="cursor: pointer;">
                        <InputCheckbox @bind-Value="productorEdit.Destacado" /> Marcar como Productor Destacado
                    </label>
                </div>

                <!-- HISTORIA Y SOSTENIBILIDAD -->
                <h3 class="section-title">Historia y Sostenibilidad</h3>

                <div class="form-group mb-3">
                    <label>Título de la Historia</label>
                    <InputText class="form-control-admin" @bind-Value="productorEdit.HistoriaTitulo"
                               placeholder="Título para la sección de historia" />
                </div>

                <div class="form-group mb-3">
                    <label>Texto de la Historia / Trayectoria</label>
                    <InputTextArea class="form-control-admin" @bind-Value="productorEdit.Historia" rows="4"
                                   placeholder="Relato detallado de la historia del productor..." />
                </div>

                <div class="form-group mb-3">
                    <label>Descripción de Sostenibilidad</label>
                    <InputTextArea class="form-control-admin" @bind-Value="productorEdit.SostenibilidadDescripcion" rows="3"
                                   placeholder="Prácticas sostenibles y cuidado ambiental..." />
                </div>

                <!-- IMAGEN PRINCIPAL -->
                <h3 class="section-title">Imagen Principal</h3>

                <div class="form-group mb-3">
                    <InputText class="form-control-admin" @bind-Value="productorEdit.ImagenPrincipal"
                               placeholder="URL de la imagen principal" />
                    <InputFile OnChange="SubirImagenPrincipal" accept="image/*" class="form-control-admin mt-2" />

                    @if (!string.IsNullOrEmpty(productorEdit.ImagenPrincipal))
                    {
                        <div style="margin-top: 8px;">
                            <img src="@ApiService.GetFullImageUrl(productorEdit.ImagenPrincipal)" alt="Vista previa principal"
                                 style="max-height: 120px; border-radius: 4px; border: 1px solid #ccc;" />
                        </div>
                    }
                </div>

                <!-- PROCEDIMIENTOS -->
                <h3 class="section-title">Procedimientos del Productor</h3>

                @for (int i = 0; i < productorEdit.Procedimientos.Count; i++)
                {
                    var index = i;
                    var proc = productorEdit.Procedimientos[index];
                    <div class="proceso-box"
                         style="margin-bottom: 15px; border: 1px solid #ddd; padding: 15px; border-radius: 6px; background-color: #f9f9f9;">

                        <div class="form-group mb-2">
                            <label>Nombre del Procedimiento</label>
                            <InputText class="form-control-admin" @bind-Value="proc.Nombre" placeholder="Ej: Recolección selectiva" />
                        </div>

                        <div class="form-group mb-2">
                            <label>Título</label>
                            <InputText class="form-control-admin" @bind-Value="proc.Titulo"
                                       placeholder="Ej: Selección manual de grano en punto óptimo" />
                        </div>

                        <div class="form-group mb-2">
                            <label>Descripción</label>
                            <InputTextArea class="form-control-admin" @bind-Value="proc.Descripcion" rows="2" />
                        </div>

                        <div class="form-group mb-2">
                            <label>Imagen (URL o subir archivo)</label>
                            <InputText class="form-control-admin" @bind-Value="proc.Imagen" placeholder="URL de la imagen" />
                            <InputFile OnChange="@(e => SubirImagenProcedimiento(e, index))" accept="image/*"
                                       class="form-control-admin mt-1" />

                            @if (!string.IsNullOrEmpty(proc.Imagen))
                            {
                                <img src="@ApiService.GetFullImageUrl(proc.Imagen)" alt="Vista previa procedimiento"
                                     style="max-height: 80px; margin-top: 5px; display: block; border-radius: 4px;" />
                            }
                        </div>

                        <button type="button" class="btn-action-delete" style="margin-top: 10px;"
                                @onclick="() => EliminarProcedimiento(proc)">Eliminar Procedimiento</button>
                    </div>
                }

                <button type="button" class="btn-add-proceso mb-3" @onclick="AgregarProcedimiento">
                    + Agregar Procedimiento
                </button>

                <!-- BOTONES DE ACCIÓN (type="button" para evitar recarga de página) -->
                <div style="margin-top: 25px;">
                    <button class="btn-save" type="button" @onclick="Guardar" disabled="@isSaving">
                        @(isSaving ? "Guardando..." : "Guardar Productor")
                    </button>
                    <button type="button" class="btn-cancel" @onclick="Cancelar" style="margin-left: 10px;">
                        Cancelar
                    </button>
                </div>

            </EditForm>
        </div>
    }
</div>

@code {
    private List<ProductorModel> productores = new();
    private List<OrganizationModel> organizaciones = new();
    private ProductorModel productorEdit = new();
    private IBrowserFile? selectedImageFile;
    private bool editando = false;
    private bool isLoading = true;
    private bool isSaving = false;
    private string mensajeAlerta = string.Empty;
    private bool esErrorAlerta = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            isLoading = true;
            organizaciones = await ApiService.GetOrganizacionesAsync() ?? new List<OrganizationModel>();
            productores = await ApiService.GetProductoresAsync() ?? new List<ProductorModel>();
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Error al cargar datos: {ex.Message}";
            esErrorAlerta = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private string ObtenerNombreOrganizacion(int idOrg, string? orgNombre)
    {
        if (idOrg > 0)
        {
            var match = organizaciones.FirstOrDefault(o => o.Id == idOrg);
            if (match != null) return match.Nombre;
        }
        return !string.IsNullOrEmpty(orgNombre) ? orgNombre : "Sin asignar";
    }

    private void NuevoProductor()
    {
        selectedImageFile = null;
        productorEdit = new ProductorModel
        {
            IdOrganizacion = organizaciones.FirstOrDefault()?.Id ?? 1,
            Procedimientos = new List<ProcedimientoModel>()
        };

        mensajeAlerta = string.Empty;
        editando = true;
    }

    private void EditarProductor(ProductorModel p)
    {
        selectedImageFile = null;
        productorEdit = new ProductorModel
        {
            Id = p.Id,
            IdOrganizacion = p.IdOrganizacion > 0 ? p.IdOrganizacion : (organizaciones.FirstOrDefault()?.Id ?? 1),
            Destacado = p.Destacado,
            Nombre = p.Nombre,
            Ubicacion = p.Ubicacion,
            Historia = p.Historia,
            ImagenUrl = p.ImagenUrl,
            Frase = p.Frase,
            HistoriaTitulo = p.HistoriaTitulo,
            HistoriaTexto = p.HistoriaTexto,
            SostenibilidadDescripcion = p.SostenibilidadDescripcion,
            ImagenPrincipal = p.ImagenPrincipal,
            OrganizacionNombre = p.OrganizacionNombre,
            Procedimientos = p.Procedimientos?.Select(x => new ProcedimientoModel
            {
                Id = x.Id,
                Nombre = x.Nombre,
                Titulo = x.Titulo,
                Descripcion = x.Descripcion,
                Imagen = x.Imagen,
                IdProductor = x.IdProductor
            }).ToList() ?? new List<ProcedimientoModel>()
        };

        mensajeAlerta = string.Empty;
        editando = true;
    }

    private async Task SubirImagenPrincipal(InputFileChangeEventArgs e)
    {
        if (e.File != null)
        {
            try
            {
                selectedImageFile = e.File;
                var url = await ApiService.UploadImageAsync(e.File);
                if (!string.IsNullOrEmpty(url))
                {
                    productorEdit.ImagenPrincipal = url;
                    productorEdit.ImagenUrl = url;
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                mensajeAlerta = $"Error al cargar imagen principal: {ex.Message}";
                esErrorAlerta = true;
            }
        }
    }

    private async Task SubirImagenProcedimiento(InputFileChangeEventArgs e, int index)
    {
        if (e.File != null && index < productorEdit.Procedimientos.Count)
        {
            try
            {
                var url = await ApiService.UploadImageAsync(e.File);
                if (!string.IsNullOrEmpty(url))
                {
                    productorEdit.Procedimientos[index].Imagen = url;
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                mensajeAlerta = $"Error al subir imagen de procedimiento: {ex.Message}";
                esErrorAlerta = true;
            }
        }
    }

    private void AgregarProcedimiento()
    {
        productorEdit.Procedimientos.Add(new ProcedimientoModel());
    }

    private void EliminarProcedimiento(ProcedimientoModel proc)
    {
        productorEdit.Procedimientos.Remove(proc);
    }

    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(productorEdit.Nombre))
        {
            mensajeAlerta = "El nombre del productor es obligatorio.";
            esErrorAlerta = true;
            return;
        }

        if (productorEdit.IdOrganizacion <= 0 && organizaciones.Any())
        {
            productorEdit.IdOrganizacion = organizaciones.First().Id;
        }

        try
        {
            isSaving = true;
            esErrorAlerta = false;

            if (productorEdit.Id == 0)
            {
                var ok = await ApiService.CrearProductorAsync(productorEdit, selectedImageFile);
                if (ok)
                {
                    // Actualización optimista: agregamos directamente a la lista sin re-consultar a Azure
                    productores.Add(productorEdit);
                    mensajeAlerta = $"¡Productor '{productorEdit.Nombre}' creado exitosamente!";
                    esErrorAlerta = false;
                    editando = false;
                    selectedImageFile = null;
                }
                else
                {
                    mensajeAlerta = "Error al crear el productor en el servidor. Verifica que los campos requeridos estén completos.";
                    esErrorAlerta = true;
                }
            }
            else
            {
                var ok = await ApiService.ActualizarProductorAsync(productorEdit, selectedImageFile);
                if (ok)
                {
                    // Actualización optimista: modificamos directamente el registro en memoria
                    var idx = productores.FindIndex(p => p.Id == productorEdit.Id);
                    if (idx >= 0)
                    {
                        productores[idx] = productorEdit;
                    }
                    else
                    {
                        productores.Add(productorEdit);
                    }

                    mensajeAlerta = $"¡Productor '{productorEdit.Nombre}' actualizado exitosamente!";
                    esErrorAlerta = false;
                    editando = false;
                    selectedImageFile = null;
                }
                else
                {
                    mensajeAlerta = "Error al actualizar el productor en el servidor. Verifica que los campos requeridos estén completos.";
                    esErrorAlerta = true;
                }
            }
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Error inesperado al guardar: {ex.Message}";
            esErrorAlerta = true;
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private async Task EliminarProductor(int id)
    {
        try
        {
            var p = productores.FirstOrDefault(x => x.Id == id);
            var nombre = p?.Nombre ?? $"#{id}";

            var ok = await ApiService.EliminarProductorAsync(id);
            if (ok)
            {
                // Remoción optimista local: no se re-consulta para evitar race conditions
                productores.RemoveAll(x => x.Id == id);
                mensajeAlerta = $"Productor '{nombre}' eliminado correctamente.";
                esErrorAlerta = false;
            }
            else
            {
                mensajeAlerta = $"No se pudo eliminar el productor '{nombre}'.";
                esErrorAlerta = true;
            }
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Error al eliminar productor: {ex.Message}";
            esErrorAlerta = true;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private void Cancelar()
    {
        editando = false;
        selectedImageFile = null;
        mensajeAlerta = string.Empty;
    }
}