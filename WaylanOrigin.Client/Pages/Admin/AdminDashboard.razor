    private async Task OpenCreateProductModal()
    {
        isEditingProduct = false;
        formErrorMessage = "";
        productFormId = "";
        productFormNombre = "";
        productFormRegion = "Tolima, Colombia";
        productFormPrecio = 35000;
        productFormFormato = "Grano";
        productFormPerfilSabor = "Dulce";
        productFormMetodoRecomendado = "Filtrado";
        productFormIntensidad = 3;
        productFormEtiqueta = "";

        availableNotes = await ApiService.GetNotasAsync();

        productFormIdCategoria = categories.FirstOrDefault()?.Id ?? 1;
        productFormTueste = 2;
        productFormProceso = 1;
        productFormStock = 20;
        productFormDescripcion = "";

        productFormSelectedNoteIds.Clear();
        selectedImageFile = null;
        showProductModal = true;
    }

    private async Task OpenEditProductModal(Product p)
    {
        isEditingProduct = true;
        formErrorMessage = "";
        productFormId = p.Id;
        productFormNombre = p.Nombre;
        productFormRegion = p.Region;
        productFormPrecio = (int)p.Precio;
        productFormFormato = p.Formato;
        productFormPerfilSabor = p.PerfilSabor;
        productFormMetodoRecomendado = p.MetodoRecomendado;
        productFormIntensidad = p.Intensidad;
        productFormEtiqueta = p.Etiqueta;
        editingProductImageUrl = p.ImagenUrl;

        availableNotes = await ApiService.GetNotasAsync();

        productFormIdCategoria = (p.IdCategoria > 0 && categories.Any(c => c.Id == p.IdCategoria))
                    ? p.IdCategoria
                    : (categories.FirstOrDefault(c => c.Nombre.Equals(p.Formato, StringComparison.OrdinalIgnoreCase))?.Id ??
        (categories.FirstOrDefault()?.Id ?? 1));

        productFormTueste = p.Tueste == "Claro" ? 1 : p.Tueste == "Oscuro" ? 3 : 2;
        productFormProceso = p.Proceso == "Natural" ? 2 : p.Proceso == "Honey" ? 3 : 1;
        productFormStock = p.Stock;
        productFormDescripcion = p.Descripcion ?? "";

        productFormSelectedNoteIds = new List<int>();
        if (p.Notas != null && p.Notas.Any())
        {
            foreach (var note in p.Notas)
            {
                int matchedId = note.Id;
                if (matchedId <= 0 && !string.IsNullOrWhiteSpace(note.Nombre))
                {
                    var found = availableNotes.FirstOrDefault(an => an.Nombre.Trim().Equals(note.Nombre.Trim(), StringComparison.OrdinalIgnoreCase));
                    if (found != null) matchedId = found.Id;
                }
                if (matchedId > 0 && !productFormSelectedNoteIds.Contains(matchedId))
                {
                    productFormSelectedNoteIds.Add(matchedId);
                }
            }
        }

        selectedImageFile = null;
        showProductModal = true;
    }

    private void CloseProductModal()
    {
        showProductModal = false;
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedImageFile = e.File;
    }

    private void ToggleFormNoteSelection(int noteId)
    {
        if (noteId <= 0) return;
        if (productFormSelectedNoteIds.Contains(noteId))
            productFormSelectedNoteIds.Remove(noteId);
        else
            productFormSelectedNoteIds.Add(noteId);
    }

    private async Task SaveProduct()
    {
        formErrorMessage = "";
        if (string.IsNullOrEmpty(productFormNombre))
        {
            formErrorMessage = "Por favor, completa los campos requeridos (Nombre).";
            return;
        }

        if (!isEditingProduct && selectedImageFile == null)
        {
            formErrorMessage = "La imagen es obligatoria al crear un nuevo producto.";
            return;
        }

        int targetCatId = productFormIdCategoria;
        if (!categories.Any(c => c.Id == targetCatId))
        {
            var matchedCat = categories.FirstOrDefault(c => c.Nombre.Equals(productFormFormato,
StringComparison.OrdinalIgnoreCase));
            targetCatId = matchedCat?.Id ?? (categories.FirstOrDefault()?.Id ?? 1);
        }

        string descToSend = string.IsNullOrWhiteSpace(productFormDescripcion)
            ? "Café de especialidad Waylan Origin con perfil de notas seleccionadas."
            : productFormDescripcion;

        var content = new MultipartFormDataContent();
        content.Add(new StringContent(productFormNombre), "Nombre");
        content.Add(new StringContent(targetCatId.ToString()), "IdCategoria");
        content.Add(new StringContent(productFormTueste.ToString()), "tueste");
        content.Add(new StringContent(productFormTueste.ToString()), "Tueste");
        content.Add(new StringContent(productFormProceso.ToString()), "proceso");
        content.Add(new StringContent(productFormProceso.ToString()), "Proceso");
        content.Add(new StringContent(descToSend), "Descripcion");
        content.Add(new StringContent(productFormPrecio.ToString()), "Precio");
        content.Add(new StringContent(productFormStock.ToString()), "Stock");

        if (selectedImageFile != null)
        {
            using var ms = new MemoryStream();
            await selectedImageFile.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024).CopyToAsync(ms);
            byte[] fileBytes = ms.ToArray();
            string imageBase64 = $"data:{selectedImageFile.ContentType};base64,{Convert.ToBase64String(fileBytes)}";
            content.Add(new StringContent(imageBase64), "ImagenBase64");

            var fileContent = new ByteArrayContent(fileBytes);
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(selectedImageFile.ContentType);
            content.Add(fileContent, "Imagen", selectedImageFile.Name);
        }

        var validNoteIds = productFormSelectedNoteIds.Where(id => id > 0).Distinct().ToList();
        if (validNoteIds.Any())
        {
            foreach (var nid in validNoteIds)
            {
                content.Add(new StringContent(nid.ToString()), "IdNotas");
            }
        }
        else
        {
            int defaultNoteId = availableNotes.FirstOrDefault(n => n.Id > 0)?.Id ?? 1;
            content.Add(new StringContent(defaultNoteId.ToString()), "IdNotas");
        }

        bool success;
        if (isEditingProduct)
        {
            success = await ApiService.ActualizarProductoAsync(productFormId, content);
        }
        else
        {
            success = await ApiService.CrearProductoAsync(content);
        }

        if (success)
        {
            showProductModal = false;
            await LoadActiveTabData();
        }
        else
        {
            formErrorMessage = "Ocurrió un error en el servidor al guardar el producto. Inténtalo de nuevo.";
        }
    }

