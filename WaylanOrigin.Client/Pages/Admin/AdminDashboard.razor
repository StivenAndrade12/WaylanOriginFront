@page "/admin"
@inject ApiService ApiService
@inject NavigationManager NavigationManager

<div class="admin-dashboard-page">

    <!-- HEADER BAR -->
    <header class="admin-header">
        <div class="admin-header-container">
            <div class="brand-info">
                <img src="logotipo/waylan.png" alt="Waylan Logo" class="admin-logo" />
                <span class="admin-badge">PANEL ADMINISTRATIVO</span>
            </div>
            <div class="user-info-bar">
                <span>Hola, <strong>@ApiService.CurrentUser?.Nombre</strong></span>
                <button class="btn-logout" @onclick="HandleLogout">Cerrar Sesión</button>
            </div>
        </div>
    </header>

    @if (!ApiService.IsLoggedIn)
    {
        <!-- LOGIN PANEL FOR ADMINISTRATOR -->
        <div class="admin-login-box">
            <div class="login-card">
                <h2>Iniciar Sesión como Administrador</h2>
                <p>Ingresa tus credenciales autorizadas de Waylan Origin.</p>

                @if (!string.IsNullOrEmpty(loginErrorMessage))
                {
                    <div class="error-alert">@loginErrorMessage</div>
                }

                <div class="form-group">
                    <label>Correo Electrónico</label>
                    <input type="email" @bind="loginEmail" placeholder="admin@waylan.com" class="form-control-admin" />
                </div>
                <div class="form-group">
                    <label>Contraseña</label>
                    <input type="password" @bind="loginPassword" placeholder="••••••••" class="form-control-admin" />
                </div>
                <button class="btn-admin-submit" @onclick="HandleLogin" type="button">INGRESAR AL PANEL</button>
            </div>
        </div>
    }
    else if (!ApiService.IsAdmin)
    {
        <div class="unauthorized-box">
            <div class="unauthorized-card">
                <h2>Acceso Denegado</h2>
                <p>Tu cuenta no cuenta con permisos de administrador en el sistema.</p>
                <button class="btn-admin-submit" @onclick='() => NavigationManager.NavigateTo("./")'>IR AL INICIO</button>
            </div>
        </div>
    }
    else
    {
        <!-- MAIN DASHBOARD CONTENT -->
        <div class="dashboard-body">

            <!-- SIDE NAVIGATION TABS -->
            <aside class="dashboard-sidebar">
                <button class="sidebar-tab-btn @(activeTab == "productos" ? "active" : "")"
                        @onclick='() => SetActiveTab("productos")'>
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="12,2 2,22 22,22" />
                    </svg>
                    Gestión Productos
                </button>
                <button class="sidebar-tab-btn @(activeTab == "categorias" ? "active" : "")"
                        @onclick='() => SetActiveTab("categorias")'>
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="9" />
                        <rect x="14" y="3" width="7" height="5" />
                        <rect x="14" y="12" width="7" height="9" />
                        <rect x="3" y="16" width="7" height="5" />
                    </svg>
                    Gestión Categorías
                </button>
                <button class="sidebar-tab-btn @(activeTab == "pedidos" ? "active" : "")"
                        @onclick='() => SetActiveTab("pedidos")'>
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="9" cy="21" r="1" />
                        <circle cx="20" cy="21" r="1" />
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                    </svg>
                    Pedidos de Clientes
                </button>
                <button class="sidebar-tab-btn @(activeTab == "usuarios" ? "active" : "")"
                        @onclick='() => SetActiveTab("usuarios")'>
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                    Control Usuarios
                </button>
                <button class="sidebar-tab-btn @(activeTab == "notas" ? "active" : "")"
                        @onclick='() => SetActiveTab("notas")'>
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10" />
                        <path d="M12 8v8" />
                        <path d="M8 12h8" />
                    </svg>
                    Gestión Notas de Sabor
                </button>
                <button class="sidebar-tab-btn @(activeTab == "cita" ? "active" : "")"
                 @onclick='() => SetActiveTab("cita")'>
                 <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                   <circle cx="12" cy="8" r="4" />
                  <path d="M12 20v-8" />
                  <path d="M9 14l3 3l3-3" />
                  </svg>
                  Editar Cita Semanal
                </button>


            </aside>

            <!-- ACTION DISPLAY PANEL -->
            <main class="dashboard-content-panel">

                @if (activeTab == "productos")
                {
                    <!-- TAB 1: PRODUCT MANAGEMENT -->
                    <div class="panel-section">
                        <div class="panel-header-row">
                            <h2>Productos Registrados</h2>
                            <button class="btn-create-new" @onclick="OpenCreateProductModal">NUEVO PRODUCTO</button>
                        </div>

                        @if (products.Any(p => p.Stock < 5))
                        {
                            <div class="stock-warning-banner">
                                <div class="stock-banner-header">
                                    <span class="stock-alert-icon" style="font-size: 1.2rem;">⚠️</span>
                                    <div>
                                        <strong>ALERTA DE INVENTARIO:</strong>
                                        <span>Hay @products.Count(p => p.Stock < 5) producto(s) que requieren reabastecimiento pronto.</span>
                                    </div>
                                </div>
                                <div class="stock-banner-pills">
                                    @if (products.Any(p => p.Stock <= 0))
                                    {
                                        <span class="stock-pill-badge out-of-stock-pill">
                                            🔴 @products.Count(p => p.Stock <= 0) AGOTADO(S) (0 un.)
                                        </span>
                                    }
                                    @if (products.Any(p => p.Stock > 0 && p.Stock < 5))
                                    {
                                        <span class="stock-pill-badge low-stock-pill">
                                            ⚠️ @products.Count(p => p.Stock > 0 && p.Stock < 5) STOCK CRÍTICO (&lt;5 un.)
                                        </span>
                                    }
                                </div>
                            </div>
                        }

                        <div class="table-container">
                            <table class="admin-table">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Imagen</th>
                                        <th>Nombre</th>
                                        <th>Categoría</th>
                                        <th>Tueste</th>
                                        <th>Proceso</th>
                                        <th>Precio</th>
                                        <th>Stock</th>
                                        <th>Notas</th>
                                        <th>Estado</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in PaginatedProducts)
                                    {
                                        <tr class="@(p.Stock <= 0 ? "row-out-of-stock" : p.Stock < 5 ? "row-low-stock" : "")">
                                            <td><strong>#@p.Id</strong></td>
                                            <td>
                                                <img src="@ApiService.GetFullImageUrl(p.ImagenUrl)" alt="@p.Nombre"
                                                     class="admin-prod-img" />
                                            </td>
                                            <td><strong>@p.Nombre</strong></td>
                                            <td>@(string.IsNullOrEmpty(p.CategoriaNombre) ? p.Formato : p.CategoriaNombre)</td>
                                            <td><span class="badge-tueste">@(string.IsNullOrEmpty(p.Tueste) ? "Medio" :
                                                                                        p.Tueste)</span></td>
                                                <td><span class="badge-proceso">@(string.IsNullOrEmpty(p.Proceso) ? "Lavado" :
                                                                                            p.Proceso)</span></td>
                                                    <td><strong>$@p.Precio.ToString("N0") COP</strong></td>
                                                    <td>
                                                        @if (p.Stock <= 0)
                                                        {
                                                            <span class="stock-badge out-of-stock">
                                                                🔴 AGOTADO (0 un.)
                                                            </span>
                                                        }
                                                        else if (p.Stock < 5)
                                                        {
                                                            <span class="stock-badge low-stock">
                                                                ⚠️ CRÍTICO (@p.Stock un.)
                                                            </span>
                                                        }
                                                        else if (p.Stock <= 10)
                                                        {
                                                            <span class="stock-badge low-stock-soft">
                                                                📦 @p.Stock un.
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="stock-badge in-stock">
                                                                ✅ @p.Stock un.
                                                            </span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (p.Notas != null && p.Notas.Any())
                                                        {
                                                            <div class="notes-pill-group">
                                                                @foreach (var n in p.Notas)
                                                                {
                                                                    <span class="note-pill">@n.Nombre</span>
                                                                }
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="status-badge @(p.Activo ? "active" : "inactive")">
                                                            @(p.Activo ? "Activo" : "Inactivo")
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <button class="btn-action-edit"
                                                                @onclick="() => OpenEditProductModal(p)">Editar</button>
                                                        <button class="btn-action-status" @onclick="() => ToggleProductStatus(p)">
                                                            @(p.Activo ? "Desactivar" : "Activar")
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <div class="admin-pagination-bar">
                                    <div class="pagination-info">
                                        <span>Mostrando <strong>@StartItemProducts - @EndItemProducts</strong> de <strong>@products.Count</strong> registros</span>
                                        <span class="pagination-divider-v">|</span>
                                        <span>Página <strong>@currentPageProducts</strong> de <strong>@TotalPagesProducts</strong></span>
                                    </div>
                                    <div class="pagination-controls">
                                        <div class="page-size-picker">
                                            <span>Mostrar</span>
                                            <select value="@pageSizeProducts" @onchange="OnPageSizeProductsChanged" class="select-page-size">
                                                <option value="5">5</option>
                                                <option value="10">10</option>
                                                <option value="20">20</option>
                                                <option value="50">50</option>
                                            </select>
                                        </div>
                                        <div class="pagination-buttons">
                                            <button class="btn-page-nav" disabled="@(currentPageProducts <= 1)" @onclick="() => GoToPageProducts(1)" title="Primera página">««</button>
                                            <button class="btn-page-nav" disabled="@(currentPageProducts <= 1)" @onclick="() => GoToPageProducts(currentPageProducts - 1)" title="Página anterior">‹</button>
                                            <select value="@currentPageProducts" @onchange='(e) => GoToPageProducts(int.Parse(e.Value?.ToString() ?? "1"))' class="select-page-number">
                                                @for (int i = 1; i <= TotalPagesProducts; i++)
                                                {
                                                    <option value="@i">@i</option>
                                                }
                                            </select>
                                            <button class="btn-page-nav" disabled="@(currentPageProducts >= TotalPagesProducts)" @onclick="() => GoToPageProducts(currentPageProducts + 1)" title="Página siguiente">›</button>
                                            <button class="btn-page-nav" disabled="@(currentPageProducts >= TotalPagesProducts)" @onclick="() => GoToPageProducts(TotalPagesProducts)" title="Última página">»»</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                else if (activeTab == "categorias")
                        {
                            <!-- TAB 2: CATEGORIES MANAGEMENT -->
                            <div class="panel-section">
                                <div class="panel-header-row">
                                    <h2>Categorías de Productos</h2>
                                    <div class="add-category-inline">
                                        <input type="text" @bind="newCategoryName" placeholder="Nueva Categoría"
                                               class="form-control-inline" />
                                        <button class="btn-create-new" @onclick="CreateCategory">AGREGAR</button>
                                    </div>
                                </div>

                                <div class="table-container">
                                    <table class="admin-table">
                                        <thead>
                                            <tr>
                                                <th>ID</th>
                                                <th>Nombre</th>
                                                <th>Estado</th>
                                                <th>Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var c in PaginatedCategories)
                                            {
                                                <tr>
                                                    <td><strong>#@c.Id</strong></td>
                                                    <td>
                                                        @if (editingCategoryId == c.Id)
                                                        {
                                                            <input type="text" @bind="editingCategoryName" class="form-control-table" />
                                                        }
                                                        else
                                                        {
                                                            @c.Nombre
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="status-badge @(c.Activo ? "active" : "inactive")">
                                                            @(c.Activo ? "Activo" : "Inactivo")
                                                        </span>
                                                    </td>
                                                    <td>
                                                        @if (editingCategoryId == c.Id)
                                                        {
                                                            <button class="btn-action-save"
                                                                    @onclick="() => SaveCategoryEdit(c)">Guardar</button>
                                                            <button class="btn-action-cancel" @onclick="CancelCategoryEdit">Cancelar</button>
                                                        }
                                                        else
                                                        {
                                                            <button class="btn-action-edit"
                                                                    @onclick="() => StartCategoryEdit(c)">Editar</button>
                                                            <button class="btn-action-status" @onclick="() => ToggleCategoryStatus(c)">
                                                                @(c.Activo ? "Desactivar" : "Activar")
                                                            </button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <div class="admin-pagination-bar">
                                    <div class="pagination-info">
                                        <span>Mostrando <strong>@StartItemCategories - @EndItemCategories</strong> de <strong>@categories.Count</strong> registros</span>
                                        <span class="pagination-divider-v">|</span>
                                        <span>Página <strong>@currentPageCategories</strong> de <strong>@TotalPagesCategories</strong></span>
                                    </div>
                                    <div class="pagination-controls">
                                        <div class="page-size-picker">
                                            <span>Mostrar</span>
                                            <select value="@pageSizeCategories" @onchange="OnPageSizeCategoriesChanged" class="select-page-size">
                                                <option value="5">5</option>
                                                <option value="10">10</option>
                                                <option value="20">20</option>
                                                <option value="50">50</option>
                                            </select>
                                        </div>
                                        <div class="pagination-buttons">
                                            <button class="btn-page-nav" disabled="@(currentPageCategories <= 1)" @onclick="() => GoToPageCategories(1)" title="Primera página">««</button>
                                            <button class="btn-page-nav" disabled="@(currentPageCategories <= 1)" @onclick="() => GoToPageCategories(currentPageCategories - 1)" title="Página anterior">‹</button>
                                            <select value="@currentPageCategories" @onchange='(e) => GoToPageCategories(int.Parse(e.Value?.ToString() ?? "1"))' class="select-page-number">
                                                @for (int i = 1; i <= TotalPagesCategories; i++)
                                                {
                                                    <option value="@i">@i</option>
                                                }
                                            </select>
                                            <button class="btn-page-nav" disabled="@(currentPageCategories >= TotalPagesCategories)" @onclick="() => GoToPageCategories(currentPageCategories + 1)" title="Página siguiente">›</button>
                                            <button class="btn-page-nav" disabled="@(currentPageCategories >= TotalPagesCategories)" @onclick="() => GoToPageCategories(TotalPagesCategories)" title="Última página">»»</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (activeTab == "pedidos")
                        {
                            <!-- TAB 3: ORDERS MANAGEMENT -->
                            <div class="panel-section">
                                <div
                                    style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 15px;">
                                    <h2>Pedidos Recibidos</h2>
                                    @if (pendingOrderStateChanges.Any())
                                    {
                                        <button class="btn-save" @onclick="SavePendingOrderStateChanges"
                                                style="background-color: #B89A5E; color: #1A100A; border: none; font-weight: 800; padding: 10px 20px; border-radius: 6px; cursor: pointer;">
                                            💾 GUARDAR CAMBIOS DE PEDIDOS (@pendingOrderStateChanges.Count PENDIENTES)
                                        </button>
                                    }
                                </div>

                                @if (!string.IsNullOrEmpty(orderStatusSuccessMessage))
                                {
                                    <div
                                        style="background-color: #E2F3E7; color: #2F6F4C; padding: 12px 18px; border-radius: 8px; margin-bottom: 20px; font-weight: 700;">
                                        @orderStatusSuccessMessage
                                    </div>
                                }

                                <div class="admin-filter-bar">
                                    <div class="search-input-wrapper">
                                        <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="11" cy="11" r="8"></circle>
                                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                        </svg>
                                        <input type="text" @bind="searchOrdersQuery" @bind:event="oninput" placeholder="Buscar por Código, Nombre de usuario o Email..." class="admin-search-input" />
                                        @if (!string.IsNullOrEmpty(searchOrdersQuery))
                                        {
                                            <button class="btn-clear-search" @onclick='() => searchOrdersQuery = ""'>×</button>
                                        }
                                    </div>
                                    <div class="filter-dropdown-wrapper">
                                        <label>Estado:</label>
                                        <select @bind="filterOrderStatus" class="admin-filter-select">
                                            <option value="Todos">Todos los Estados</option>
                                            <option value="Pendiente">Pendiente</option>
                                            <option value="EnPreparacion">En Preparación</option>
                                            <option value="EnTransito">En Tránsito</option>
                                            <option value="EnReparto">En Reparto</option>
                                            <option value="Entregado">Entregado</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="table-container">
                                    <table class="admin-table">
                                        <thead>
                                            <tr>
                                                <th>ID</th>
                                                <th>Código Seguimiento</th>
                                                <th>Fecha</th>
                                                <th>Usuario / Email</th>
                                                <th>Dirección</th>
                                                <th>Total</th>
                                                <th>Estado Pago</th>
                                                <th>Estado Pedido</th>
                                                <th>Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var o in PaginatedOrders)
                                            {
                                                bool isPending = pendingOrderStateChanges.ContainsKey(o.Codigo);
                                                string currentState = isPending ? pendingOrderStateChanges[o.Codigo] : o.Estado;

                                                <tr style="@(isPending ? "background-color: #FEF9F0;" : "")">
                                                    <td><code>#@o.Id</code></td>
                                                    <td><strong>@o.Codigo</strong></td>
                                                    <td>@o.Fecha.ToLocalTime().ToString("g")</td>
                                                    <td>
                                                        <div><strong>@(string.IsNullOrEmpty(o.NombreUsuario) ? "Cliente" :
                                                                                                        o.NombreUsuario)</strong></div>
                                                            <small class="text-muted"
                                                                   style="font-size: 0.72rem; color: #706B64;">@o.EmailCliente</small>
                                                        </td>
                                                        <td class="address-cell">
                                                            <div class="address-card-box">
                                                                <svg class="address-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                                                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                                                                    <circle cx="12" cy="10" r="3" />
                                                                </svg>
                                                                <span class="address-text">@(string.IsNullOrEmpty(o.Direccion) ? "Dirección no especificada" : o.Direccion)</span>
                                                            </div>
                                                        </td>
                                                        <td><strong>$@o.Total.ToString("N0") COP</strong></td>
                                                        <td>
                                                            <span class="status-badge active"
                                                                  style="font-size:0.72rem; font-weight:800; padding:4px 10px; border-radius:12px; text-transform:uppercase;">
                                                                💳 @o.EstadoPago
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <select class="select-order-state @GetOrderStateBadgeClass(currentState)" value="@currentState"
                                                                    @onchange='(e) => OnOrderStateSelected(o.Codigo, e.Value?.ToString() ?? "")'>
                                                                <option value="Pendiente">⏳ Pendiente</option>
                                                                <option value="EnPreparacion">☕ En Preparación</option>
                                                                <option value="EnTransito">🚚 En Tránsito</option>
                                                                <option value="EnReparto">📦 En Reparto</option>
                                                                <option value="Entregado">✅ Entregado</option>
                                                            </select>
                                                        </td>
                                                        <td>
                                                            <div style="display: flex; gap: 6px;">
                                                                <button class="btn-table-action edit" @onclick="() => ViewOrderDetails(o)"
                                                                        title="Ver Productos">
                                                                    👁️ Productos (@o.Detalles.Count)
                                                                </button>
                                                                @if (isPending)
                                                                {
                                                                    <button class="btn-save" @onclick="() => SaveSingleOrderState(o.Codigo)"
                                                                            style="padding: 4px 8px; font-size: 0.75rem;">
                                                                        💾 Guardar
                                                                    </button>
                                                                }
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="admin-pagination-bar">
                                        <div class="pagination-info">
                                            <span>Mostrando <strong>@StartItemOrders - @EndItemOrders</strong> de <strong>@FilteredOrders.Count</strong> registros</span>
                                            <span class="pagination-divider-v">|</span>
                                            <span>Página <strong>@currentPageOrders</strong> de <strong>@TotalPagesOrders</strong></span>
                                        </div>
                                        <div class="pagination-controls">
                                            <div class="page-size-picker">
                                                <span>Mostrar</span>
                                                <select value="@pageSizeOrders" @onchange="OnPageSizeOrdersChanged" class="select-page-size">
                                                    <option value="5">5</option>
                                                    <option value="10">10</option>
                                                    <option value="20">20</option>
                                                    <option value="50">50</option>
                                                </select>
                                            </div>
                                            <div class="pagination-buttons">
                                                <button class="btn-page-nav" disabled="@(currentPageOrders <= 1)" @onclick="() => GoToPageOrders(1)" title="Primera página">««</button>
                                                <button class="btn-page-nav" disabled="@(currentPageOrders <= 1)" @onclick="() => GoToPageOrders(currentPageOrders - 1)" title="Página anterior">‹</button>
                                                <select value="@currentPageOrders" @onchange='(e) => GoToPageOrders(int.Parse(e.Value?.ToString() ?? "1"))' class="select-page-number">
                                                    @for (int i = 1; i <= TotalPagesOrders; i++)
                                                    {
                                                        <option value="@i">@i</option>
                                                    }
                                                </select>
                                                <button class="btn-page-nav" disabled="@(currentPageOrders >= TotalPagesOrders)" @onclick="() => GoToPageOrders(currentPageOrders + 1)" title="Página siguiente">›</button>
                                                <button class="btn-page-nav" disabled="@(currentPageOrders >= TotalPagesOrders)" @onclick="() => GoToPageOrders(TotalPagesOrders)" title="Última página">»»</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                else if (activeTab == "usuarios")
                            {
                                <!-- TAB 4: USER CONTROL -->
                                <div class="panel-section">
                                    <h2>Usuarios Registrados</h2>

                                    <div class="admin-filter-bar">
                                        <div class="search-input-wrapper">
                                            <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="11" cy="11" r="8"></circle>
                                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                            </svg>
                                            <input type="text" @bind="searchUsersQuery" @bind:event="oninput" placeholder="Buscar usuario por Nombre, Email o Rol..." class="admin-search-input" />
                                            @if (!string.IsNullOrEmpty(searchUsersQuery))
                                            {
                                                <button class="btn-clear-search" @onclick='() => searchUsersQuery = ""'>×</button>
                                            }
                                        </div>
                                        <div class="filter-dropdown-wrapper">
                                            <label>Rol:</label>
                                            <select @bind="filterUserRole" class="admin-filter-select">
                                                <option value="Todos">Todos los Roles</option>
                                                <option value="Admin">Administrador</option>
                                                <option value="Cliente">Cliente</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="table-container">
                                        <table class="admin-table">
                                            <thead>
                                                <tr>
                                                    <th>Nombre</th>
                                                    <th>Correo Electrónico</th>
                                                    <th>Rol de Acceso</th>
                                                    <th>Estado</th>
                                                    <th>Acciones</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var u in PaginatedUsers)
                                                {
                                                    <tr>
                                                        <td>@u.Nombre</td>
                                                        <td>@u.Email</td>
                                                        <td>
                                                            <span class="role-badge @(u.Rol == "Admin" ? "admin" : "client")">
                                                                @u.Rol
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <span class="status-badge @(u.Activo ? "active" : "inactive")">
                                                                @(u.Activo ? "Activo" : "Inactivo")
