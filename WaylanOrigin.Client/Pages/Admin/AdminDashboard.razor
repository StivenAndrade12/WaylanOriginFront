                                <div class="form-group">
                                    <label>Descripción del Producto</label>
                                    <textarea @bind="productFormDescripcion" placeholder="Escribe una breve descripción del café..."
                                              rows="3" class="form-control-admin" style="resize: vertical;"></textarea>
