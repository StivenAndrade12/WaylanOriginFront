                                        <div style="background-color: #E2F3E7; color: #2F6F4C; padding: 12px 18px; border-radius: 8px; margin-bottom: 20px; font-weight: 700;">
                                            @noteActionMessage
                                        </div>
                                    }

                                    <div class="table-container">
                                        <table class="admin-table">
                                            <thead>
                                                <tr>
                                                    <th>ID</th>
                                                    <th>Nombre de la Nota de Sabor</th>
                                                    <th>Acciones</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var n in availableNotes)
                                                {
                                                    <tr>
                                                        <td><strong>#@n.Id</strong></td>
                                                        <td>
                                                            @if (editingNoteId == n.Id)
                                                            {
                                                                <input type="text" @bind="editingNoteName" class="form-control-table" />
                                                            }
                                                            else
                                                            {
                                                                <span style="display: inline-block; background: #FAF6F0; border: 1px solid #E5E2DC; padding: 4px 12px; border-radius: 20px; font-weight: 600; color: #5C4033;">
                                                                    ☕ @n.Nombre
                                                                </span>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (editingNoteId == n.Id)
                                                            {
                                                                <button class="btn-action-save" @onclick="() => SaveNoteEdit(n)">Guardar</button>
                                                                <button class="btn-action-cancel" @onclick="CancelNoteEdit">Cancelar</button>
                                                            }
                                                            else
                                                            {
                                                                <button class="btn-action-edit" @onclick="() => StartNoteEdit(n)">Editar</button>
                                                            }

                                                           
                                                        </td>
                                                    </tr>
                                                }

                                              
                                                
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }

                            else if (activeTab == "cita")
                            {
                               <AdminCitaSemanal />
                            }


                        </main>
                    </div>
                }

                <!-- POPUP MODAL FOR PRODUCT CREATE/EDIT -->
                @if (showProductModal)
                {
                    <div class="modal-backdrop">
                        <div class="modal-box">
                            <div class="modal-header">
                                <h3>@(isEditingProduct ? "Editar Producto" : "Nuevo Producto")</h3>
                                <button class="btn-close-modal" @onclick="CloseProductModal">×</button>
                            </div>
                            <div class="modal-body">

                                @if (!string.IsNullOrEmpty(formErrorMessage))
                                {
                                    <div class="error-alert">@formErrorMessage</div>
                                }

                                <div class="form-row-2">
                                    <div class="form-group">
                                        <label>Nombre Comercial</label>
                                        <input type="text" @bind="productFormNombre" placeholder="Waylan Classic"
                                               class="form-control-admin" />
                                    </div>
                                    <div class="form-group">
                                        <label>Categoría</label>
                                        <select @bind="productFormIdCategoria" class="form-control-admin">
                                            @foreach (var cat in categories)
                                            {
                                                <option value="@cat.Id">@cat.Nombre</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="form-row-2">
                                    <div class="form-group">
                                        <label>Tipo de Tueste</label>
                                        <select @bind="productFormTueste" class="form-control-admin">
                                            <option value="1">Claro</option>
                                            <option value="2">Medio</option>
                                            <option value="3">Oscuro</option>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label>Proceso de Café</label>
                                        <select @bind="productFormProceso" class="form-control-admin">
                                            <option value="1">Lavado</option>
                                            <option value="2">Natural</option>
                                            <option value="3">Honey</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="form-row-2">
                                    <div class="form-group">
                                        <label>Precio Unitario (COP)</label>
                                        <input type="number" @bind="productFormPrecio" class="form-control-admin" />
                                    </div>
                                    <div class="form-group">
                                        <label>Stock Disponible</label>
                                        <input type="number" min="0" @bind="productFormStock" class="form-control-admin" />
