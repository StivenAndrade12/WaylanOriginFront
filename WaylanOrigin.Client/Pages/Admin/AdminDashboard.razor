                                    {
                                        <span class="file-help">Actualmente tiene: <strong>@editingProductImageUrl</strong> (déjalo vacío si
                                            no deseas cambiarla).</span>
                                        }
                                    </div>

                                    <!-- Notes selection Many-To-Many -->
                                    <div class="form-group">
                                        <label>Notas de Sabor Seleccionadas</label>
                                        <div class="notes-selection-grid">
                                            @foreach (var n in availableNotes)
                                            {
                                                <label class="checkbox-note-container">
                                                    <input type="checkbox" checked="@productFormSelectedNoteIds.Contains(n.Id)"
                                                           @onchange='() => ToggleFormNoteSelection(n.Id)' />
                                                    <span class="note-label">@n.Nombre</span>
                                                </label>
                                            }
                                        </div>
                                    </div>

                                </div>
                                <div class="modal-footer">
                                    <button class="btn-cancel" @onclick="CloseProductModal">CANCELAR</button>
                                    <button class="btn-save" @onclick="SaveProduct" type="button">GUARDAR PRODUCTO</button>
                                </div>
                            </div>
                        </div>
                    }

                    @if (showOrderDetailsModal && selectedOrderForView != null)
                    {
                        <div class="modal-backdrop">
                            <div class="modal-box" style="max-width: 650px;">
                                <div class="modal-header">
                                    <h3>Detalles del Pedido: @selectedOrderForView.Codigo</h3>
                                    <button class="btn-close-modal" @onclick="CloseOrderDetailsModal">×</button>
                                </div>
                                <div class="modal-body">
                                    <div
                                        style="margin-bottom: 15px; font-size: 0.88rem; background: #FAF6F0; padding: 12px; border-radius: 8px;">
                                        <div><strong>ID Pedido:</strong> #@selectedOrderForView.Id</div>
                                        <div><strong>Cliente:</strong> @selectedOrderForView.NombreUsuario
                                            (@selectedOrderForView.EmailCliente)</div>
                                            <div><strong>Dirección de Entrega:</strong> @(string.IsNullOrEmpty(selectedOrderForView.Direccion) ?
                                                        "Dirección registrada" : selectedOrderForView.Direccion)</div>
                                                <div><strong>Fecha:</strong> @selectedOrderForView.Fecha.ToLocalTime().ToString("g")</div>
                                                <div><strong>Estado de Pago:</strong> @selectedOrderForView.EstadoPago</div>
                                                <div><strong>Total:</strong> $@selectedOrderForView.Total.ToString("N0") COP</div>
                                            </div>

                                            <h4 style="margin-bottom: 10px; font-size: 0.95rem; font-family: 'Playfair Display', serif;">Productos
                                                Comprados (detallesAdmin)</h4>
                                                <div style="display: flex; flex-direction: column; gap: 10px;">
                                                    @foreach (var d in selectedOrderForView.Detalles)
                                                    {
                                                        <div
                                                            style="display: flex; align-items: center; gap: 12px; padding: 10px; border: 1px solid #E5E2DC; border-radius: 8px; background: #FFFFFF;">
                                                            <img src="@ApiService.GetFullImageUrl(d.ImagenProducto)" alt="@d.NombreProducto"
                                                                 style="width: 50px; height: 50px; object-fit: cover; border-radius: 6px; border: 1px solid #E5E2DC;" />
                                                            <div style="flex: 1;">
                                                                <div style="font-weight: 700; font-size: 0.9rem;">@d.NombreProducto</div>
                                                                <div style="font-size: 0.78rem; color: #706B64;">ID Producto: #@d.IdProducto | Cantidad:
                                                                    @d.Cantidad | Unitario: $@d.PrecioUnitario.ToString("N0") COP</div>
                                                                </div>
                                                                <div style="font-weight: 800; font-size: 0.95rem; color: #1A100A;">
                                                                    $@(d.SubTotal > 0 ? d.SubTotal.ToString("N0") : (d.Cantidad *
                                                                                                d.PrecioUnitario).ToString("N0")) COP
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn-cancel" @onclick="CloseOrderDetailsModal">CERRAR</button>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                </div>

@code {
    private Order? selectedOrderForView = null;
    private bool showOrderDetailsModal = false;

    private void ViewOrderDetails(Order o)
    {
        selectedOrderForView = o;
        showOrderDetailsModal = true;
    }

    private void CloseOrderDetailsModal()
    {
        showOrderDetailsModal = false;
        selectedOrderForView = null;
    }

    private string activeTab = "productos";

    // Authentication States
    private string loginEmail = "";
    private string loginPassword = "";
    private string loginErrorMessage = "";

    // Entities lists
    private List<Product> products = new();
    private List<Category> categories = new();
    private List<Order> orders = new();
    private List<User> users = new();
    private List<Note> availableNotes = new();

    // --- PAGINATION STATE ---
    private int pageSizeProducts = 10;
    private int currentPageProducts = 1;

    private int pageSizeCategories = 10;
    private int currentPageCategories = 1;

    private int pageSizeOrders = 10;
    private int currentPageOrders = 1;

    private int pageSizeUsers = 10;
    private int currentPageUsers = 1;

    // --- COMPUTED PAGINATED LISTS ---
    private IEnumerable<Product> PaginatedProducts =>
        products.Skip((currentPageProducts - 1) * pageSizeProducts).Take(pageSizeProducts);
    private int TotalPagesProducts => (int)Math.Ceiling((double)Math.Max(1, products.Count) / pageSizeProducts);
    private int StartItemProducts => products.Any() ? ((currentPageProducts - 1) * pageSizeProducts) + 1 : 0;
    private int EndItemProducts => Math.Min(currentPageProducts * pageSizeProducts, products.Count);

    private void GoToPageProducts(int page)
    {
        currentPageProducts = Math.Clamp(page, 1, TotalPagesProducts);
    }
    private void OnPageSizeProductsChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            pageSizeProducts = val;
            currentPageProducts = 1;
        }
    }

    private IEnumerable<Category> PaginatedCategories =>
        categories.Skip((currentPageCategories - 1) * pageSizeCategories).Take(pageSizeCategories);
    private int TotalPagesCategories => (int)Math.Ceiling((double)Math.Max(1, categories.Count) / pageSizeCategories);
    private int StartItemCategories => categories.Any() ? ((currentPageCategories - 1) * pageSizeCategories) + 1 : 0;
    private int EndItemCategories => Math.Min(currentPageCategories * pageSizeCategories, categories.Count);

    private void GoToPageCategories(int page)
    {
        currentPageCategories = Math.Clamp(page, 1, TotalPagesCategories);
    }
    private void OnPageSizeCategoriesChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            pageSizeCategories = val;
            currentPageCategories = 1;
        }
    }

    // --- SEARCH AND FILTER STATE ---
    private string searchOrdersQuery = "";
    private string filterOrderStatus = "Todos";

    private string searchUsersQuery = "";
    private string filterUserRole = "Todos";

    // --- COMPUTED FILTERED AND PAGINATED LISTS ---
    private List<Order> FilteredOrders
    {
        get
        {
            var query = orders.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(searchOrdersQuery))
            {
                var q = searchOrdersQuery.Trim();
                query = query.Where(o =>
                    o.Codigo.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    o.NombreUsuario.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    o.EmailCliente.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    o.Direccion.Contains(q, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(filterOrderStatus) && filterOrderStatus != "Todos")
            {
                query = query.Where(o => o.Estado.Equals(filterOrderStatus, StringComparison.OrdinalIgnoreCase));
            }
            return query.ToList();
        }
    }

    private IEnumerable<Order> PaginatedOrders =>
        FilteredOrders.Skip((currentPageOrders - 1) * pageSizeOrders).Take(pageSizeOrders);
    private int TotalPagesOrders => (int)Math.Ceiling((double)Math.Max(1, FilteredOrders.Count) / pageSizeOrders);
    private int StartItemOrders => FilteredOrders.Any() ? ((currentPageOrders - 1) * pageSizeOrders) + 1 : 0;
    private int EndItemOrders => Math.Min(currentPageOrders * pageSizeOrders, FilteredOrders.Count);

    private void GoToPageOrders(int page)
    {
        currentPageOrders = Math.Clamp(page, 1, TotalPagesOrders);
    }
    private void OnPageSizeOrdersChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            pageSizeOrders = val;
            currentPageOrders = 1;
        }
    }

    private List<User> FilteredUsers
    {
        get
        {
            var query = users.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(searchUsersQuery))
            {
                var q = searchUsersQuery.Trim();
                query = query.Where(u =>
                    u.Nombre.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    u.Email.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    u.Rol.Contains(q, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(filterUserRole) && filterUserRole != "Todos")
            {
                query = query.Where(u => u.Rol.Equals(filterUserRole, StringComparison.OrdinalIgnoreCase));
            }
            return query.ToList();
        }
    }

    private IEnumerable<User> PaginatedUsers =>
        FilteredUsers.Skip((currentPageUsers - 1) * pageSizeUsers).Take(pageSizeUsers);
    private int TotalPagesUsers => (int)Math.Ceiling((double)Math.Max(1, FilteredUsers.Count) / pageSizeUsers);
    private int StartItemUsers => FilteredUsers.Any() ? ((currentPageUsers - 1) * pageSizeUsers) + 1 : 0;
    private int EndItemUsers => Math.Min(currentPageUsers * pageSizeUsers, FilteredUsers.Count);

    private void GoToPageUsers(int page)
    {
        currentPageUsers = Math.Clamp(page, 1, TotalPagesUsers);
    }
    private void OnPageSizeUsersChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            pageSizeUsers = val;
            currentPageUsers = 1;
        }
    }

    // Modals & Form variables
    private bool showProductModal = false;
    private bool isEditingProduct = false;
    private string formErrorMessage = "";

    private string productFormId = "";
    private string productFormNombre = "";
    private string productFormRegion = "Tolima, Colombia";
    private int productFormPrecio = 35000;
    private string productFormFormato = "Grano";
    private string productFormPerfilSabor = "Dulce";
    private string productFormMetodoRecomendado = "Filtrado";
    private int productFormIntensidad = 3;
    private string productFormEtiqueta = "";
    private string editingProductImageUrl = "";

    // New backend bindings
    private int productFormIdCategoria = 1;
    private int productFormTueste = 2; // Default Medio
    private int productFormProceso = 1; // Default Lavado
    private int productFormStock = 20;
    private string productFormDescripcion = "";

    private List<int> productFormSelectedNoteIds = new();
    private Microsoft.AspNetCore.Components.Forms.IBrowserFile? selectedImageFile;

    // Categories Inline edit
    private string newCategoryName = "";
    private int editingCategoryId = 0;
    private string editingCategoryName = "";

    // Notes Inline edit & creation
    private string newNoteName = "";
    private int editingNoteId = 0;
    private string editingNoteName = "";
    private string noteActionMessage = "";

    private async Task CreateNote()
    {
        if (string.IsNullOrWhiteSpace(newNoteName)) return;
        noteActionMessage = "";
        bool ok = await ApiService.CrearNotaAsync(newNoteName.Trim());
        if (ok)
        {
            newNoteName = "";
            availableNotes = await ApiService.GetNotasAsync();
            noteActionMessage = "¡Nota de sabor guardada exitosamente en la Base de Datos!";
        }
    }

    private void StartNoteEdit(Note n)
    {
        editingNoteId = n.Id;
        editingNoteName = n.Nombre;
    }

    private void CancelNoteEdit()
    {
        editingNoteId = 0;
        editingNoteName = "";
    }

    private async Task SaveNoteEdit(Note n)
    {
        if (string.IsNullOrWhiteSpace(editingNoteName)) return;
        noteActionMessage = "";
        bool ok = await ApiService.ActualizarNotaAsync(n.Id, editingNoteName.Trim());
        if (ok)
        {
            editingNoteId = 0;
            editingNoteName = "";
            availableNotes = await ApiService.GetNotasAsync();
            noteActionMessage = "¡Nota de sabor actualizada exitosamente en la Base de Datos!";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (ApiService.IsLoggedIn)
        {
            await LoadActiveTabData();
        }
    }

    private async Task HandleLogin()
    {
        loginErrorMessage = "";
        if (string.IsNullOrEmpty(loginEmail) || string.IsNullOrEmpty(loginPassword))
        {
            loginErrorMessage = "Por favor ingresa todos los campos.";
            return;
        }

        var success = await ApiService.LoginAsync(loginEmail, loginPassword);
        if (success)
        {
            if (ApiService.IsAdmin)
            {
                await LoadActiveTabData();
            }
            else
            {
                ApiService.Logout();
                loginErrorMessage = "Acceso denegado. Tu cuenta no tiene permisos de administrador.";
            }
        }
        else
        {
            if (!string.IsNullOrEmpty(ApiService.LastLoginError) && ApiService.LastLoginError.Contains("no ha sido activada"))
            {
                loginErrorMessage = "Tu cuenta aún no ha sido activada en la Base de Datos de Azure. Por favor ingresa el código de activación desde la pantalla de Verificación.";
            }
            else
            {
                loginErrorMessage = !string.IsNullOrEmpty(ApiService.LastLoginError)
                    ? ApiService.LastLoginError
                    : "Credenciales incorrectas o usuario inactivo.";
            }
        }
    }

    private void HandleLogout()
    {
        ApiService.Logout();
        NavigationManager.NavigateTo("admin", forceLoad: true);
    }

    private async Task SetActiveTab(string tabName)
    {
        activeTab = tabName;
        await LoadActiveTabData();
    }

    private async Task LoadActiveTabData()
    {
        try
        {
            if (activeTab == "productos")
            {
                products = await ApiService.GetTodosProductosAsync();
                availableNotes = await ApiService.GetNotasAsync();
                var rawCats = await ApiService.GetTodasCategoriasAsync();
                categories = rawCats.GroupBy(c => c.Id).Select(g => g.First()).ToList();
            }
            else if (activeTab == "categorias")
            {
                var rawCats = await ApiService.GetTodasCategoriasAsync();
                categories = rawCats.GroupBy(c => c.Id).Select(g => g.First()).ToList();
            }
            else if (activeTab == "pedidos")
            {
                orders = await ApiService.GetTodosPedidosAsync();
            }
            else if (activeTab == "usuarios")
            {
                users = await ApiService.GetUsuariosAsync();
            }
            else if (activeTab == "notas")
            {
                availableNotes = await ApiService.GetNotasAsync();
            }
            

            

            
