                                                            {
                                                                <span class="self-label">Cuenta Actual</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="admin-pagination-bar">
                                        <div class="pagination-info">
                                            <span>Mostrando <strong>@StartItemUsers - @EndItemUsers</strong> de <strong>@FilteredUsers.Count</strong> registros</span>
                                            <span class="pagination-divider-v">|</span>
                                            <span>Página <strong>@currentPageUsers</strong> de <strong>@TotalPagesUsers</strong></span>
                                        </div>
                                        <div class="pagination-controls">
                                            <div class="page-size-picker">
                                                <span>Mostrar</span>
                                                <select value="@pageSizeUsers" @onchange="OnPageSizeUsersChanged" class="select-page-size">
                                                    <option value="5">5</option>
                                                    <option value="10">10</option>
                                                    <option value="20">20</option>
                                                    <option value="50">50</option>
                                                </select>
                                            </div>
                                            <div class="pagination-buttons">
                                                <button class="btn-page-nav" disabled="@(currentPageUsers <= 1)" @onclick="() => GoToPageUsers(1)" title="Primera página">««</button>
                                                <button class="btn-page-nav" disabled="@(currentPageUsers <= 1)" @onclick="() => GoToPageUsers(currentPageUsers - 1)" title="Página anterior">‹</button>
                                                <select value="@currentPageUsers" @onchange='(e) => GoToPageUsers(int.Parse(e.Value?.ToString() ?? "1"))' class="select-page-number">
                                                    @for (int i = 1; i <= TotalPagesUsers; i++)
                                                    {
                                                        <option value="@i">@i</option>
                                                    }
                                                </select>
                                                <button class="btn-page-nav" disabled="@(currentPageUsers >= TotalPagesUsers)" @onclick="() => GoToPageUsers(currentPageUsers + 1)" title="Página siguiente">›</button>
                                                <button class="btn-page-nav" disabled="@(currentPageUsers >= TotalPagesUsers)" @onclick="() => GoToPageUsers(TotalPagesUsers)" title="Última página">»»</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (activeTab == "notas")
                            {
                                <!-- TAB 5: FLAVOR NOTES MANAGEMENT -->
                                <div class="panel-section">
                                    <div class="panel-header-row">
                                        <h2>Notas de Sabor de Productos</h2>
                                        <div class="add-category-inline">
                                            <input type="text" @bind="newNoteName" placeholder="Nueva Nota de Sabor (Ej: Miel, Frutos Rojos)"
                                                   class="form-control-inline" />
