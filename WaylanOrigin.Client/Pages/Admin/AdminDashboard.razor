    // --- ORDERS OPERATIONS ---
    private Dictionary<string, string> pendingOrderStateChanges = new();
    private string orderStatusSuccessMessage = "";

    private string GetOrderStateBadgeClass(string state)
    {
        var s = (state ?? "").ToLowerInvariant().Replace(" ", "").Replace("á", "a").Replace("ó", "o");
        if (s.Contains("pendiente")) return "state-badge-pendiente";
        if (s.Contains("preparac")) return "state-badge-preparacion";
        if (s.Contains("transit") || s.Contains("reparto")) return "state-badge-transito";
        if (s.Contains("entregad") || s.Contains("completad")) return "state-badge-entregado";
        if (s.Contains("cancelad")) return "state-badge-cancelado";
        return "state-badge-pendiente";
    }

    private void OnOrderStateSelected(string codigo, string newState)
    {
        orderStatusSuccessMessage = "";
        pendingOrderStateChanges[codigo] = newState;
    }

    private async Task SaveSingleOrderState(string codigo)
    {
        if (pendingOrderStateChanges.TryGetValue(codigo, out var newState))
        {
            var success = await ApiService.CambiarEstadoPedidoAsync(codigo, newState);
            if (success)
            {
                pendingOrderStateChanges.Remove(codigo);
                orderStatusSuccessMessage = $"¡Estado del pedido {codigo} actualizado a '{newState}' exitosamente!";
                await LoadActiveTabData();
            }
        }
    }

    private async Task SavePendingOrderStateChanges()
    {
        if (!pendingOrderStateChanges.Any()) return;
        int count = 0;
        foreach (var kvp in pendingOrderStateChanges.ToList())
        {
            var success = await ApiService.CambiarEstadoPedidoAsync(kvp.Key, kvp.Value);
            if (success)
            {
                pendingOrderStateChanges.Remove(kvp.Key);
                count++;
            }
        }
        orderStatusSuccessMessage = $"¡Se actualizaron {count} pedido(s) exitosamente!";
        await LoadActiveTabData();
    }

    // --- USERS OPERATIONS ---
    private async Task ToggleUserStatus(User u)
    {
        bool nextState = !u.Activo;
        u.Activo = nextState;
        StateHasChanged();
        await ApiService.CambiarEstadoUsuarioAsync(u.Id, nextState, u.Email);
        await LoadActiveTabData();
        StateHasChanged();
    }
