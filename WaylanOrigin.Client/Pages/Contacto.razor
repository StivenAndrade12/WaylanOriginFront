@page "/contacto"

<PageTitle>Contáctanos - Waylan Origin</PageTitle>

<section class="contacto-section">
    <!-- Ilustración de Hoja/Rama de Café de Fondo (Arriba a la derecha) -->
    <div class="coffee-branch-bg"></div>

    <div class="contacto-container">

        <!-- Encabezado Centrado -->
        <div class="contacto-header text-center"
             style="text-align: center; display: flex; flex-direction: column; align-items: center;">
            <p class="subtitle-gold" style="text-align: center; margin-bottom: 8px;">ESTAMOS PARA TI</p>
            <h1 class="title-serif" style="text-align: center; margin-bottom: 12px;">Contáctanos</h1>

            <!-- Divisor centrado -->
            <div class="divider-gold" style="margin: 0 auto 16px auto;"></div>

            <p class="description-text" style="text-align: center;">
                Estamos aquí para ayudarte. Comunícate directamente con nuestro equipo a través de nuestros datos oficiales.
            </p>
        </div>

        <!-- Tarjeta Única Centrada de Información de Contacto -->
        <div class="contacto-wrapper-centered" style="max-width: 860px; margin: 0 auto;">
            <div class="info-card info-card-centered" style="background-color: #FAF7F2; border-radius: 12px; padding: 45px 40px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03); border: 1px solid rgba(195, 154, 88, 0.2);">
                <div style="text-align: center; margin-bottom: 35px;">
                    <h2 class="card-title-serif" style="font-size: 2rem; margin-bottom: 8px;">Información de contacto</h2>
                    <div class="small-divider-gold" style="margin: 0 auto;"></div>
                </div>

                <div class="info-grid-2col" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px; margin-bottom: 35px;">
                    <!-- Dirección -->
                    <div class="info-item" style="display: flex; align-items: flex-start; gap: 16px;">
                        <div class="icon-wrapper" style="width: 48px; height: 48px; background-color: #F4F0EA; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 1px solid rgba(195, 154, 88, 0.3);">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C39A58" stroke-width="1.8">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                        </div>
                        <div class="info-text">
                            <h3 style="font-size: 1rem; font-weight: 700; color: #111; margin: 0 0 2px 0;">Sede de Origen</h3>
                            <p style="font-size: 0.88rem; color: #555; margin: 0 0 10px 0; line-height: 1.4;">Cra. 4 No. 3-22 B/Avenida Planadas<br />Planadas, Tolima, Colombia</p>
                            <h3 style="font-size: 1rem; font-weight: 700; color: #111; margin: 0 0 2px 0;">Centro de Distribución</h3>
                            <p style="font-size: 0.88rem; color: #555; margin: 0; line-height: 1.4;">Cra. 45 sur 172 - 20 Parque Logístico Omega, Bodega 19, Picaleña<br />Ibagué, Tolima, Colombia</p>
                        </div>
                    </div>

                    <!-- Teléfono -->
                    <div class="info-item" style="display: flex; align-items: flex-start; gap: 16px;">
                        <div class="icon-wrapper" style="width: 48px; height: 48px; background-color: #F4F0EA; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 1px solid rgba(195, 154, 88, 0.3);">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C39A58" stroke-width="1.8">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                            </svg>
                        </div>
                        <div class="info-text">
                            <h3 style="font-size: 1.05rem; font-weight: 700; color: #111; margin: 0 0 4px 0;">Teléfono de atención</h3>
                            <p style="font-size: 0.9rem; color: #555; margin: 0; line-height: 1.5;">+57 310 797 0384</p>
                        </div>
                    </div>

                    <!-- Correo electrónico -->
                    <div class="info-item" style="display: flex; align-items: flex-start; gap: 16px;">
                        <div class="icon-wrapper" style="width: 48px; height: 48px; background-color: #F4F0EA; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 1px solid rgba(195, 154, 88, 0.3);">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C39A58" stroke-width="1.8">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                <polyline points="22,6 12,13 2,6"></polyline>
                            </svg>
                        </div>
                        <div class="info-text">
                            <h3 style="font-size: 1.05rem; font-weight: 700; color: #111; margin: 0 0 4px 0;">Correo electrónico</h3>
                            <p style="font-size: 0.9rem; color: #555; margin: 0; line-height: 1.5;">ventas@waylan.co</p>
                        </div>
                    </div>

                    <!-- Horario de atención -->
                    <div class="info-item" style="display: flex; align-items: flex-start; gap: 16px;">
                        <div class="icon-wrapper" style="width: 48px; height: 48px; background-color: #F4F0EA; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 1px solid rgba(195, 154, 88, 0.3);">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C39A58" stroke-width="1.8">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                        </div>
                        <div class="info-text">
                            <h3 style="font-size: 1.05rem; font-weight: 700; color: #111; margin: 0 0 4px 0;">Horario de atención</h3>
                            <p style="font-size: 0.9rem; color: #555; margin: 0; line-height: 1.5;">Lunes a Viernes: 8:00 a.m. - 5:00 p.m.</p>
                            <p style="font-size: 0.9rem; color: #555; margin: 0; line-height: 1.5;">Sábados: 8:00 a.m. - 12:00 m.</p>
                        </div>
                    </div>
                </div>

                <!-- Redes Sociales -->
                <div style="border-top: 1px solid rgba(195, 154, 88, 0.2); padding-top: 25px; display: flex; flex-direction: column; align-items: center; gap: 14px;">
                    <h3 style="font-size: 0.8rem; font-weight: 800; color: #706B64; letter-spacing: 1.5px; margin: 0; text-transform: uppercase;">Síguenos en Redes Sociales</h3>
                    <div class="social-icons" style="display: flex; gap: 16px;">
                        <a href="https://www.instagram.com/waylan.origin/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" style="width: 42px; height: 42px; border-radius: 50%; background-color: #F4F0EA; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(195, 154, 88, 0.3); transition: transform 0.2s;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2">
                                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                            </svg>
                        </a>
                        <a href="https://www.facebook.com/Tiendawaylan" target="_blank" rel="noopener noreferrer" aria-label="Facebook" style="width: 42px; height: 42px; border-radius: 50%; background-color: #F4F0EA; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(195, 154, 88, 0.3); transition: transform 0.2s;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2">
                                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                            </svg>
                        </a>
                        <a href="https://wa.me/573107970384?text=Hola,%20quisiera%20recibir%20m%C3%A1s%20informaci%C3%B3n" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" style="width: 42px; height: 42px; border-radius: 50%; background-color: #F4F0EA; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(195, 154, 88, 0.3); transition: transform 0.2s;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2">
                                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- BANNER INFERIOR DE BENEFICIOS (Negro) -->
    <div class="bottom-benefits-bar">
        <div class="benefits-container">
            <!-- Beneficio 1 -->
            <div class="benefit-item">
                <div class="benefit-icon">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#C39A58" stroke-width="1.5">
                        <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
                    </svg>
                </div>
                <div class="benefit-text">
                    <h4>Café de origen</h4>
                    <p>De nuestras fincas<br />a tu taza.</p>
                    <div class="mini-line-gold"></div>
                </div>
            </div>

            <!-- Beneficio 2 -->
            <div class="benefit-item">
                <div class="benefit-icon">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#C39A58" stroke-width="1.5">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                </div>
                <div class="benefit-text">
                    <h4>Relación directa</h4>
                    <p>Trabajamos de la mano con<br />nuestros productores.</p>
                    <div class="mini-line-gold"></div>
                </div>
            </div>

            <!-- Beneficio 3 -->
            <div class="benefit-item">
                <div class="benefit-icon">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#C39A58" stroke-width="1.5">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                </div>
                <div class="benefit-text">
                    <h4>Sostenibilidad</h4>
                    <p>Cuidamos la tierra para<br />un futuro mejor.</p>
                    <div class="mini-line-gold"></div>
                </div>
            </div>

            <!-- Beneficio 4 -->
            <div class="benefit-item">
                <div class="benefit-icon">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#C39A58" stroke-width="1.5">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                        <line x1="12" y1="22.08" x2="12" y2="12"></line>
                    </svg>
                </div>
                <div class="benefit-text">
                    <h4>Envíos a todo el país</h4>
                    <p>Llevamos nuestro café<br />hasta tu puerta.</p>
                    <div class="mini-line-gold"></div>
                </div>
            </div>
        </div>
    </div>
</section>