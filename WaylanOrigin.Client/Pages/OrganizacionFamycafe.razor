@page "/organizacion/famycafe"

@inject ApiService Api
@using WaylanOrigin.Client.Models

<div class="famycafe-container">

    <!-- Breadcrumb -->
    <div class="fc-breadcrumb">
        <a href="productores"><span class="arrow">←</span> Productores Aliados</a>
        <span class="separator">&gt;</span>
        <span class="active">@org?.Nombre</span>
    </div>

    <!-- Hero Section -->
    <div class="fc-hero">
        <div class="fc-hero-info">

            <!-- Título dinámico -->
            <h1 class="fc-main-title">@org?.Nombre</h1>

            <div class="separador-contenedor">

                <!-- Logo dinámico -->
                <img src="@org?.Logo" alt="Logo @org?.Nombre" class="icono-hoja">

                <div class="linea-dorada"></div>
            </div>

            <div class="contenido-texto">

                <!-- Descripciones dinámicas -->
                <p class="texto-descripcion">@org?.Descripcion1</p>
                <p class="texto-descripcion">@org?.Descripcion2</p>

            </div>
        </div>

        <!-- Imagen Hero dinámica -->
        <div class="fc-hero-image">
            <img src="@org?.HeroImagen" alt="@org?.Nombre" />
        </div>
    </div>

    <!-- Panel de estadísticas -->
    <div class="fc-stats-panel">

        <div class="fc-stat-item">
            <div class="fc-stat-icon">
                <img src="logotipo/org1.png" class="fc-icon-img" alt="Icono">
            </div>

            <!-- Año dinámico -->
            <h3 class="fc-stat-number">@org?.AnoFundacion</h3>
            <p class="fc-stat-label">Año de fundación</p>
        </div>

        <div class="fc-stat-item">
            <div class="fc-stat-icon">
                <img src="logotipo/org2.png" class="fc-icon-img" alt="Icono">
            </div>

            <!-- Familias dinámico -->
            <h3 class="fc-stat-number">@org?.Familias</h3>
            <p class="fc-stat-label">Familias caficultores</p>
        </div>

        <div class="fc-stat-item">
            <div class="fc-stat-icon">
                <img src="logotipo/org3.png" class="fc-icon-img" alt="Icono">
            </div>

            <!-- Hectáreas dinámico -->
            <h3 class="fc-stat-number">@org?.Hectareas</h3>
            <p class="fc-stat-label">Hectáreas cultivadas</p>
        </div>

        <div class="fc-stat-item">
            <div class="fc-stat-icon">
                <img src="logotipo/org4.png" class="fc-icon-img" alt="Icono">
            </div>

            <!-- Enfoque dinámico -->
            <h3 class="fc-stat-number">@org?.Enfoque</h3>
            <p class="fc-stat-label">Nuestro compromiso</p>
        </div>

    </div>

    <!-- Productores Grid Section -->
    <div class="fc-section-title-bar">
        <h2>Productores que hacen parte de @org?.Nombre</h2>
        <a href="todos-los-productores" class="fc-view-all">VER TODOS ➔</a>
    </div>

    <div class="fc-productores-grid">

        <!-- Tarjetas dinámicas de productores destacados -->
        @if (destacados != null)
        {
            @foreach (var p in destacados)
            {
                <div class="fc-producer-card">
                    <div class="fc-card-img">
                        <img src="@p.ImagenPrincipal" alt="@p.Nombre" />
                    </div>

                    <div class="fc-card-content">
                        <h3>@p.Nombre</h3>
                        <p class="fc-finca">@p.Finca</p>
                        <p class="fc-location">@p.Ubicacion</p>
                        <a href="perfil/@p.Id" class="fc-btn-profile">VER PERFIL ➔</a>
                    </div>
                </div>
            }
        }

        <!-- Tarjeta "Más productores" -->
        <div class="fc-producer-card fc-more-card">
            <div class="fc-more-content">
                <div class="fc-user-icon">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#8B5E3C" stroke-width="1.5">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                </div>
                <p>Más productores</p>
                <a href="todos-los-productores" class="fc-btn-profile fc-btn-all">VER TODOS ➔</a>
            </div>
        </div>

    </div>

</div>

@code {
    OrganizationModel org;
    List<ProductorModel> productores;
    List<ProductorModel> destacados;

    protected override async Task OnInitializedAsync()
    {
        // 1. Cargar organización desde backend
        org = await Api.GetOrganizacionByIdAsync("famycafe");

        // 2. Cargar todos los productores
        var todos = await Api.GetProductoresAsync();

        // 3. Filtrar los productores que pertenecen a esta organización
        productores = todos
            .Where(p => p.OrganizacionId == "famycafe")
            .ToList();

        // 4. Filtrar los destacados (máx 4)
        destacados = todos
            .Where(p => org?.DestacadosIds.Contains(p.Id) == true)
            .Take(4)
            .ToList();
    }
}
